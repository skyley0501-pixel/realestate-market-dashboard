// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// 都道府県マスタ（JIS X 0401 都道府県コード、2桁）
model Prefecture {
  code           String         @id
  name           String
  municipalities Municipality[]

  @@map("prefectures")
}

// 市区町村マスタ（JIS X 0402 市区町村コード、5桁）
model Municipality {
  code           String     @id
  name           String
  prefectureCode String        @map("prefecture_code")
  prefecture     Prefecture    @relation(fields: [prefectureCode], references: [code])
  stations       Station[]
  transactions   Transaction[]

  @@map("municipalities")
}

// 駅マスタ（国土数値情報 駅データ由来）
model Station {
  id               String        @id @default(cuid())
  name             String
  line             String?
  municipalityCode String        @map("municipality_code")
  municipality     Municipality  @relation(fields: [municipalityCode], references: [code])
  latitude         Float?
  longitude        Float?
  transactions     Transaction[]

  @@unique([name, line])
  @@map("stations")
}

// 不動産取引情報（国土交通省 不動産情報ライブラリ「不動産価格情報」由来）
model Transaction {
  id                   String       @id @default(cuid())
  municipalityCode     String       @map("municipality_code")
  municipality         Municipality @relation(fields: [municipalityCode], references: [code])
  stationId            String?      @map("station_id")
  station              Station?     @relation(fields: [stationId], references: [id])
  timeToStationMinutes Int?         @map("time_to_station_minutes")
  transactionPeriod    String       @map("transaction_period") // 例: "2024Q3"
  propertyType         String       @map("property_type") // 宅地(土地)/宅地(土地と建物)/中古マンション等/林地/農地
  priceYen             BigInt       @map("price_yen") // 取引価格（総額、円）
  areaSqm              Float        @map("area_sqm")
  floorPlan            String?      @map("floor_plan") // 例: "3LDK"
  buildingYear         Int?         @map("building_year")
  structure            String?
  use                  String?
  remarks              String?
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  @@index([municipalityCode])
  @@index([stationId])
  @@index([transactionPeriod])
  @@index([propertyType])
  @@map("transactions")
}
