// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// 都道府県マスタ（JIS X 0401 都道府県コード、2桁）
model Prefecture {
  code           String         @id
  name           String
  municipalities Municipality[]

  @@map("prefectures")
}

// 市区町村マスタ（JIS X 0402 市区町村コード、5桁）
model Municipality {
  code           String     @id
  name           String
  prefectureCode String        @map("prefecture_code")
  prefecture     Prefecture    @relation(fields: [prefectureCode], references: [code])
  stations       Station[]
  transactions   Transaction[]
  areaStatistics AreaStatistics[]
  aiAreaReports  AiAreaReport[]

  @@map("municipalities")
}

// 駅マスタ（国土数値情報 駅データ由来）
model Station {
  id               String        @id @default(cuid())
  name             String
  line             String?
  municipalityCode String        @map("municipality_code")
  municipality     Municipality  @relation(fields: [municipalityCode], references: [code])
  latitude         Float?
  longitude        Float?
  transactions     Transaction[]

  @@unique([name, line])
  @@map("stations")
}

// 不動産取引情報（国土交通省 不動産情報ライブラリ「不動産価格情報」由来）
model Transaction {
  id                   String       @id @default(cuid())
  municipalityCode     String       @map("municipality_code")
  municipality         Municipality @relation(fields: [municipalityCode], references: [code])
  stationId            String?      @map("station_id")
  station              Station?     @relation(fields: [stationId], references: [id])
  timeToStationMinutes Int?         @map("time_to_station_minutes")
  transactionPeriod    String       @map("transaction_period") // 例: "2024Q3"
  propertyType         String       @map("property_type") // 宅地(土地)/宅地(土地と建物)/中古マンション等/林地/農地
  priceYen             BigInt       @map("price_yen") // 取引価格（総額、円）
  areaSqm              Float        @map("area_sqm")
  floorPlan            String?      @map("floor_plan") // 例: "3LDK"
  buildingYear         Int?         @map("building_year")
  structure            String?
  use                  String?
  remarks              String?
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  @@index([municipalityCode])
  @@index([stationId])
  @@index([transactionPeriod])
  @@index([propertyType])
  @@map("transactions")
}

// 市区町村×期間で事前集計した価格統計（IQR外れ値除去済み）。エリア一覧・詳細表示の高速化のため
// Transactionからバッチ（scripts/aggregate-area-statistics.ts）で都度再計算して洗い替えする。
model AreaStatistics {
  id                    String       @id @default(cuid())
  municipalityCode      String       @map("municipality_code")
  municipality          Municipality @relation(fields: [municipalityCode], references: [code])
  period                String // 例: "2024Q3"
  medianPriceYen        BigInt       @map("median_price_yen")
  averagePriceYen       BigInt       @map("average_price_yen")
  q1PriceYen            BigInt       @map("q1_price_yen")
  q3PriceYen            BigInt       @map("q3_price_yen")
  avgUnitPriceYenPerSqm Float        @map("avg_unit_price_yen_per_sqm")
  sampleSize            Int          @map("sample_size") // 外れ値除去後の件数
  transactionCount      Int          @map("transaction_count") // 外れ値除去前の元の取引件数
  yoyChangeRatePercent  Float?       @map("yoy_change_rate_percent") // 前期比。前期データが無い場合はnull
  calculatedAt          DateTime     @default(now()) @map("calculated_at")

  @@unique([municipalityCode, period])
  @@index([period])
  @@map("area_statistics")
}

// AIが生成したエリア講評のキャッシュ。GetAreaReportUseCaseが未生成時にLlmClient（Gemini）で
// 生成し保存する。municipalityCode+periodをキャッシュキーとし、統計の対象期間が進んだら再生成する
// （GPTレビュー指摘: 期間を区別しないと古い期間の講評を返し続けてしまう）。
model AiAreaReport {
  id               String       @id @default(cuid())
  municipalityCode String       @map("municipality_code")
  municipality     Municipality @relation(fields: [municipalityCode], references: [code])
  period           String
  content          String
  generatedAt      DateTime     @default(now()) @map("generated_at")

  @@unique([municipalityCode, period])
  @@map("ai_area_reports")
}

// AIチャットの1会話セッション。userIdはPhase5でSupabase Authを導入するまでは常にnull（匿名セッション）。
model ChatSession {
  id        String        @id @default(cuid())
  userId    String?       @map("user_id")
  title     String?
  createdAt DateTime      @default(now()) @map("created_at")
  messages  ChatMessage[]

  @@map("chat_sessions")
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String      @map("session_id")
  session   ChatSession @relation(fields: [sessionId], references: [id])
  role      String // "user" | "assistant"
  content   String
  createdAt DateTime    @default(now()) @map("created_at")

  @@index([sessionId])
  @@map("chat_messages")
}

// 日本国債の利回り（財務省「国債金利情報」由来、日次）。固定金利型住宅ローンとの連動を見るための指標。
// scripts/fetch-jgb-yields.tsで財務省CSVを取得し洗い替えする。
model JgbYield {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  tenYearRate Float    @map("ten_year_rate") // 10年債利回り（%）
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([date])
  @@map("jgb_yields")
}

// 日銀の政策金利（無担保コールレート翌日物の誘導目標水準）。金融政策決定会合ごとにしか変わらない
// 階段状のデータのため、自動取得ではなく会合結果を都度手動で追加する運用とする。
model PolicyRate {
  id            String   @id @default(cuid())
  effectiveDate DateTime @map("effective_date") @db.Date // この金利が適用され始めた日
  ratePercent   Float    @map("rate_percent")
  note          String? // 例: "2026年9月 金融政策決定会合"
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([effectiveDate])
  @@map("policy_rates")
}

// 金融政策の一次情報源（日銀・FRB公式RSS）から取得した見出し。本文は保持せず、
// 見出し・発表元サイトへのリンク・公開日のみを保存する（著作権配慮のため転載しない）。
// scripts/fetch-rate-news.tsで定期取得し、既存分はurlの一致で重複を避ける。
model RateNews {
  id          String   @id @default(cuid())
  source      String // "boj" | "frb"
  title       String
  url         String
  publishedAt DateTime @map("published_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([url])
  @@index([publishedAt])
  @@map("rate_news")
}
