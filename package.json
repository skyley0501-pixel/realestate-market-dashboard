{
  "name": "realestate-market-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate && node scripts/copy-maplibre-worker.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:pull": "prisma db pull",
    "db:generate": "prisma generate",
    "fetch:reinfolib": "node scripts/fetch-reinfolib.ts",
    "db:seed": "prisma db seed",
    "db:aggregate": "tsx scripts/aggregate-area-statistics.ts",
    "fetch:jgb-yields": "tsx scripts/fetch-jgb-yields.ts",
    "seed:policy-rates": "tsx scripts/seed-policy-rates.ts",
    "fetch:rate-news": "tsx scripts/fetch-rate-news.ts",
    "seed:municipality-centroids": "tsx scripts/seed-municipality-centroids.ts",
    "fetch:hazard-zones": "tsx scripts/fetch-hazard-zones.ts",
    "fetch:disaster-history": "tsx scripts/fetch-disaster-history.ts",
    "fetch:gsi-disaster-events": "tsx scripts/fetch-gsi-disaster-events.ts",
    "fetch:condo-supply": "tsx scripts/fetch-condo-supply.ts",
    "aggregate:condo-market": "tsx scripts/aggregate-condo-market-stats.ts",
    "test": "vitest run --exclude \"**/*.integration.test.ts\"",
    "test:integration": "vitest run integration"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@google/genai": "^2.17.1",
    "@hookform/resolvers": "^5.4.2",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@types/adm-zip": "^0.5.8",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "adm-zip": "^0.6.0",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.11.1",
    "lucide-react": "^1.26.0",
    "maplibre-gl": "^6.1.0",
    "next": "16.2.11",
    "next-themes": "^0.4.6",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.83.0",
    "shadcn": "^4.14.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "prisma": "^7.9.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
